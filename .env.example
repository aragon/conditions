# Secrets and project-specific overrides.
# Copy this file to `.env` (gitignored). Network config (RPC_URL, CHAIN_ID,
# VERIFIER, BLOCKSCOUT_HOST_NAME) is resolved automatically by just-foundry
# from `lib/just-foundry/networks/<network>.env` after `just init <network>`.
#
# Recommended alternative: install `vars` (`just install-vars`) and store
# secrets there — see lib/just-foundry/README.md.

# Deployer private key (used by scripts and `just balance`/`refund`)
DEPLOYER_KEY="0x..."

# Etherscan-compatible API key (required when VERIFIER=etherscan)
ETHERSCAN_API_KEY=""

# Recipient for `just refund`
REFUND_ADDRESS="0x..."

# --- Project-specific (optional) ---
# Used by Deploy.s.sol / Create.s.sol when verifying the source code of the
# condition contracts: a dummy instance is deployed to force verification.
# DAO_ADDRESS="0x..."
# SAFE_ADDRESS="0x..."
