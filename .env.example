# Copy this file to `.env` (gitignored).
# Network config (RPC_URL, CHAIN_ID, VERIFIER, BLOCKSCOUT_HOST_NAME) is
# resolved automatically by just-foundry from `lib/just-foundry/networks/<network>.env`
# after `just init <network>`.

# Recommended alternative: install `vars` (`just install-vars`) and store
# secrets there — see lib/just-foundry/README.md.

# DEPLOYER_KEY=

# ETHERSCAN_API_KEY=

# REFUND_ADDRESS=

# --- Project-specific ---

# Used by Create.s.sol
# DAO_ADDRESS=

# Used by Create.s.sol and Deploy.s.sol
# SAFE_ADDRESS=
